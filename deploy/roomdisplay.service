[Unit]
Description=Raumbelegung e-Paper Display (7.5" HAT B V3)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
# Pfade ggf. an Installationsort anpassen
WorkingDirectory=/opt/room-display
Environment=ROOMDISPLAY_CONFIG=/opt/room-display/config.yaml
ExecStart=/opt/room-display/venv/bin/python -m roomdisplay
Restart=always
RestartSec=10
User=pi
# SPI-Zugriff: Nutzer in die Gruppe "gpio" und "spi" aufnehmen, sonst auskommentieren
SupplementaryGroups=spi gpio

[Install]
WantedBy=multi-user.target
